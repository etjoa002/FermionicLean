import FermionicLean.Fock.Thermal
import FermionicLean.Gaussian.BlockRotation

/-! # Unitary evolution generated by a quadratic Hamiltonian

`evolution h t = exp (-i t H_h)` is unitary with the group law (Lemma 8). In the block form it is
the diagonal matrix of the phases `exp (-i t d_ε(s))` and implements the block rotation
`R(t ε)` (Lemma 10); hence for every antisymmetric `h` it implements `exp (-t h)`
(Theorem 11(a)), `U* c_a U = ∑_b (exp (t h))_ab c_b` (Heisenberg form, (b)), a density operator
`σ` evolves to a density operator with covariance `exp (t h) Γ(σ) exp (-t h)` ((c)), and
`i [H_h, c_a] = ∑_b h_ab c_b` ((d)). The exponential state `ρ_h` is stationary (Corollary 12).
-/

open Matrix NormedSpace

namespace Fermionic

variable {n : ℕ}

/-- Definition 7: the evolution operator `U_h(t) = exp (-i t H_h)`. -/
noncomputable def evolution (h : Matrix (MajoranaIndex n) (MajoranaIndex n) ℝ) (t : ℝ) :
    Matrix (FockIndex n) (FockIndex n) ℂ :=
  exp ((-(Complex.I * (t : ℂ))) • quadHam h)

/-! ### Lemma 8: unitarity and the group law -/

section Unitary

variable {h : Matrix (MajoranaIndex n) (MajoranaIndex n) ℝ}

lemma commute_smul_quadHam (c d : ℂ) : Commute (c • quadHam h) (d • quadHam h) :=
  ((Commute.refl (quadHam h)).smul_left c).smul_right d

/-- Lemma 8: `U_h(t)* = U_h(-t)`. -/
theorem evolution_conjTranspose (hh : h.transpose = -h) (t : ℝ) :
    (evolution h t).conjTranspose = evolution h (-t) := by
  unfold evolution
  rw [← Matrix.exp_conjTranspose, Matrix.conjTranspose_smul, quadHam_conjTranspose hh]
  congr 2
  simp only [Complex.star_def, map_neg, map_mul, Complex.conj_I, Complex.conj_ofReal]
  push_cast
  ring

/-- Lemma 8: `U_h(s) U_h(t) = U_h(s + t)`. -/
theorem evolution_add (s t : ℝ) : evolution h s * evolution h t = evolution h (s + t) := by
  unfold evolution
  rw [← Matrix.exp_add_of_commute _ _ (commute_smul_quadHam _ _), ← add_smul]
  congr 2
  push_cast
  ring

/-- Lemma 8: `U_h(0) = 1`. -/
theorem evolution_zero : evolution h 0 = 1 := by
  unfold evolution
  simp

/-- Lemma 8: `U_h(t) U_h(t)* = 1`. -/
theorem evolution_mul_conjTranspose (hh : h.transpose = -h) (t : ℝ) :
    evolution h t * (evolution h t).conjTranspose = 1 := by
  rw [evolution_conjTranspose hh, evolution_add, add_neg_cancel, evolution_zero]

/-- Lemma 8: `U_h(t)* U_h(t) = 1`. -/
theorem conjTranspose_mul_evolution (hh : h.transpose = -h) (t : ℝ) :
    (evolution h t).conjTranspose * evolution h t = 1 := by
  rw [evolution_conjTranspose hh, evolution_add, neg_add_cancel, evolution_zero]

end Unitary

/-! ### Lemma 10: evolution in the block form -/

/-- The phase `exp (-i t d_ε(s))` of the configuration `s`. -/
noncomputable def evolutionPhase (ε : Fin n → ℝ) (t : ℝ) (s : FockIndex n) : ℂ :=
  Complex.exp (-(Complex.I * t * blockEnergy ε s))

/-- Lemma 10: `U_{D(ε)}(t) = diag (exp (-i t d_ε(s)))`. -/
theorem evolution_blockForm (ε : Fin n → ℝ) (t : ℝ) :
    evolution (blockForm ε) t = Matrix.diagonal (evolutionPhase ε t) := by
  unfold evolution evolutionPhase
  rw [quadHam_blockForm, ← Matrix.diagonal_smul, Matrix.exp_diagonal]
  congr 1
  funext s
  rw [Pi.coe_exp, ← Complex.exp_eq_exp_ℂ, Pi.smul_apply, smul_eq_mul]
  congr 1
  ring

lemma coe_fin_two_add_one (b : Fin 2) : (((b + 1 : Fin 2) : ℕ) : ℝ) = 1 - ((b : ℕ) : ℝ) := by
  fin_cases b <;> simp

/-- The flip of bit `j` changes `d_ε` by `ε_j (1 - 2 s_j)`. -/
lemma blockEnergy_flip (ε : Fin n → ℝ) (j : Fin n) (s : FockIndex n) :
    blockEnergy ε (flip j s) = blockEnergy ε s + ε j * (1 - 2 * ((s j : ℕ) : ℝ)) := by
  unfold blockEnergy
  rw [← sub_eq_iff_eq_add', ← Finset.sum_sub_distrib, Finset.sum_eq_single j]
  · rw [flip_apply_self, coe_fin_two_add_one]
    ring
  · intro k _ hk
    rw [flip_apply_ne hk]
    ring
  · intro hj; exact absurd (Finset.mem_univ j) hj

/-- The entry identity: `f(flip_j s) conj f(s) = cos (t ε_j) - i sin (t ε_j) (-1)^{s_j}`. -/
lemma evolutionPhase_flip_mul_star (ε : Fin n → ℝ) (t : ℝ) (j : Fin n) (s : FockIndex n) :
    evolutionPhase ε t (flip j s) * star (evolutionPhase ε t s) =
      (Real.cos (t * ε j) : ℂ) - Complex.I * Real.sin (t * ε j) * bitSign (s j) := by
  unfold evolutionPhase
  rw [Complex.star_def, ← Complex.exp_conj, ← Complex.exp_add]
  have hexp : -(Complex.I * t * (blockEnergy ε (flip j s) : ℂ)) +
      (starRingEnd ℂ) (-(Complex.I * t * (blockEnergy ε s : ℂ))) =
      -(t * ε j : ℂ) * bitSign (s j) * Complex.I := by
    simp only [map_neg, map_mul, Complex.conj_I, Complex.conj_ofReal, blockEnergy_flip,
      bitSign_eq]
    push_cast
    ring
  rw [hexp]
  generalize s j = b
  fin_cases b
  · simp only [bitSign, Fin.zero_eta, Fin.isValue, ↓reduceIte, mul_one]
    rw [Complex.exp_mul_I, Complex.cos_neg, Complex.sin_neg]
    push_cast
    ring
  · simp only [bitSign, Fin.mk_one, Fin.isValue, one_ne_zero, ↓reduceIte, mul_neg, mul_one,
      neg_neg]
    rw [Complex.exp_mul_I]
    push_cast
    ring

/-- The diagonal of the entry identity: `cos (t ε_j) 1 - i sin (t ε_j) Z_j`. -/
lemma diagonal_evolutionPhase_flip_mul_star (ε : Fin n → ℝ) (t : ℝ) (j : Fin n) :
    Matrix.diagonal (fun s => evolutionPhase ε t (flip j s) * star (evolutionPhase ε t s)) =
      (Real.cos (t * ε j) : ℂ) • (1 : Matrix (FockIndex n) (FockIndex n) ℂ) -
        (Complex.I * Real.sin (t * ε j)) • pauliZ j := by
  ext s u
  simp only [evolutionPhase_flip_mul_star, pauliZ, Matrix.diagonal_apply, Matrix.sub_apply,
    Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
  split_ifs <;> simp

lemma diagonal_mul_diagonal_comm (d e : FockIndex n → ℂ) :
    Matrix.diagonal d * Matrix.diagonal e = Matrix.diagonal e * Matrix.diagonal d := by
  rw [Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
  congr 1
  funext i
  exact mul_comm _ _

/-- Moving a diagonal matrix through the flip from the left. -/
lemma diagonal_mul_pauliX (d : FockIndex n → ℂ) (j : Fin n) :
    Matrix.diagonal d * pauliX j = pauliX j * Matrix.diagonal (fun s => d (flip j s)) := by
  rw [pauliX_mul_diagonal]
  simp only [flip_flip]

/-- `diag f (diag σ X_j) = diag σ X_j diag (f ∘ flip_j)`. -/
lemma diagonal_mul_diagonal_mul_pauliX (f σ : FockIndex n → ℂ) (j : Fin n) :
    Matrix.diagonal f * (Matrix.diagonal σ * pauliX j) =
      Matrix.diagonal σ * pauliX j * Matrix.diagonal (fun s => f (flip j s)) := by
  rw [← Matrix.mul_assoc, diagonal_mul_diagonal_comm, Matrix.mul_assoc, diagonal_mul_pauliX,
    Matrix.mul_assoc]

/-- `c_{x_j} Z_j = -i c_{y_j}`. -/
lemma majorana_x_mul_pauliZ (j : Fin n) :
    majorana (Sum.inl j) * pauliZ j = (-Complex.I) • majorana (Sum.inr j) := by
  simp only [majorana, smul_smul, neg_mul, Complex.I_mul_I, neg_neg, one_smul]

/-- `c_{y_j} Z_j = i c_{x_j}`. -/
lemma majorana_y_mul_pauliZ (j : Fin n) :
    majorana (Sum.inr j) * pauliZ j = Complex.I • majorana (Sum.inl j) := by
  simp only [majorana, Matrix.smul_mul, Matrix.mul_assoc, pauliZ_mul_self, Matrix.mul_one]

/-- `diag f c_{x_j} diag f* = c_{x_j} diag ((f ∘ flip_j) f*)`. -/
lemma diagonal_conj_majorana_x (f : FockIndex n → ℂ) (j : Fin n) :
    Matrix.diagonal f * majorana (Sum.inl j) * (Matrix.diagonal f).conjTranspose =
      majorana (Sum.inl j) * Matrix.diagonal (fun s => f (flip j s) * star (f s)) := by
  rw [Matrix.diagonal_conjTranspose]
  change Matrix.diagonal f * (Matrix.diagonal (stringSign j) * pauliX j) * Matrix.diagonal (star f)
    = Matrix.diagonal (stringSign j) * pauliX j * Matrix.diagonal _
  rw [diagonal_mul_diagonal_mul_pauliX, Matrix.mul_assoc, Matrix.diagonal_mul_diagonal]
  rfl

/-- `diag f c_{y_j} diag f* = c_{y_j} diag ((f ∘ flip_j) f*)`. -/
lemma diagonal_conj_majorana_y (f : FockIndex n → ℂ) (j : Fin n) :
    Matrix.diagonal f * majorana (Sum.inr j) * (Matrix.diagonal f).conjTranspose =
      majorana (Sum.inr j) * Matrix.diagonal (fun s => f (flip j s) * star (f s)) := by
  rw [Matrix.diagonal_conjTranspose]
  change Matrix.diagonal f * (Complex.I • (Matrix.diagonal (stringSign j) * pauliX j * pauliZ j)) *
      Matrix.diagonal (star f) =
    Complex.I • (Matrix.diagonal (stringSign j) * pauliX j * pauliZ j) * Matrix.diagonal _
  rw [Matrix.mul_smul, Matrix.smul_mul, Matrix.smul_mul]
  congr 1
  rw [← Matrix.mul_assoc (Matrix.diagonal f), diagonal_mul_diagonal_mul_pauliX, pauliZ]
  simp only [Matrix.mul_assoc, Matrix.diagonal_mul_diagonal]
  congr 3
  funext i
  simp only [Pi.star_apply]
  ring

/-- The row `x_j` of the block rotation as a two-term sum. -/
lemma sum_blockRotation_x_smul (θ : Fin n → ℝ) (j : Fin n)
    (g : MajoranaIndex n → Matrix (FockIndex n) (FockIndex n) ℂ) :
    ∑ b, ((blockRotation θ (Sum.inl j) b : ℝ) : ℂ) • g b =
      (Real.cos (θ j) : ℂ) • g (Sum.inl j) - (Real.sin (θ j) : ℂ) • g (Sum.inr j) := by
  simp only [blockRotation, Fintype.sum_sum_type, Matrix.fromBlocks_apply₁₁,
    Matrix.fromBlocks_apply₁₂, Matrix.neg_apply, Matrix.diagonal_apply]
  simp only [apply_ite (fun r : ℝ => (r : ℂ)), Complex.ofReal_zero, Complex.ofReal_neg, ite_smul,
    zero_smul, Finset.sum_ite_eq, Finset.mem_univ, ite_true, neg_smul, Finset.sum_neg_distrib,
    sub_eq_add_neg]

/-- The row `y_j` of the block rotation as a two-term sum. -/
lemma sum_blockRotation_y_smul (θ : Fin n → ℝ) (j : Fin n)
    (g : MajoranaIndex n → Matrix (FockIndex n) (FockIndex n) ℂ) :
    ∑ b, ((blockRotation θ (Sum.inr j) b : ℝ) : ℂ) • g b =
      (Real.sin (θ j) : ℂ) • g (Sum.inl j) + (Real.cos (θ j) : ℂ) • g (Sum.inr j) := by
  simp only [blockRotation, Fintype.sum_sum_type, Matrix.fromBlocks_apply₂₁,
    Matrix.fromBlocks_apply₂₂, Matrix.diagonal_apply]
  simp only [apply_ite (fun r : ℝ => (r : ℂ)), Complex.ofReal_zero, ite_smul, zero_smul,
    Finset.sum_ite_eq, Finset.mem_univ, ite_true]

/-- Lemma 10: `U_{D(ε)}(t)` implements `R(t ε)`. -/
theorem conjugatesMajorana_evolution_blockForm (ε : Fin n → ℝ) (t : ℝ) :
    ConjugatesMajorana (evolution (blockForm ε) t) (blockRotation (t • ε)) := by
  rw [evolution_blockForm]
  rintro (j | j)
  · rw [diagonal_conj_majorana_x, diagonal_evolutionPhase_flip_mul_star, Matrix.mul_sub,
      Matrix.mul_smul, Matrix.mul_smul, Matrix.mul_one, majorana_x_mul_pauliZ, smul_smul,
      sum_blockRotation_x_smul]
    simp only [Pi.smul_apply, smul_eq_mul]
    congr 1
    rw [show Complex.I * (Real.sin (t * ε j) : ℂ) * -Complex.I = (Real.sin (t * ε j) : ℂ) by
      ring_nf; simp]
  · rw [diagonal_conj_majorana_y, diagonal_evolutionPhase_flip_mul_star, Matrix.mul_sub,
      Matrix.mul_smul, Matrix.mul_smul, Matrix.mul_one, majorana_y_mul_pauliZ, smul_smul,
      sum_blockRotation_y_smul]
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [show Complex.I * (Real.sin (t * ε j) : ℂ) * Complex.I = -(Real.sin (t * ε j) : ℂ) by
      ring_nf; simp, neg_smul, sub_neg_eq_add, add_comm]

/-! ### Theorem 11: unitary evolution is a rotation -/

section Rotated

variable {U : Matrix (FockIndex n) (FockIndex n) ℂ}
  {O : Matrix (MajoranaIndex n) (MajoranaIndex n) ℝ} {ε : Fin n → ℝ}

/-- Theorem 11(a): `U_h(t) = U* U_{D(ε)}(t) U` for `h = O D(ε) Oᵀ` and `U` implementing `O`. -/
theorem evolution_conj (hU' : U.conjTranspose * U = 1) (hO : ConjugatesMajorana U O)
    (hOO : O * O.transpose = 1) (t : ℝ) :
    evolution (O * blockForm ε * O.transpose) t =
      U.conjTranspose * evolution (blockForm ε) t * U := by
  unfold evolution
  rw [← conjTranspose_mul_quadHam_blockForm_mul hU' hO hOO, ← Matrix.smul_mul, ← Matrix.mul_smul,
    exp_conjTranspose_mul_mul hU']

/-- Theorem 11(a): `exp (-t h) = O R(t ε) Oᵀ` for `h = O D(ε) Oᵀ`. -/
theorem exp_neg_smul_conj (hOO : O * O.transpose = 1) (t : ℝ) :
    exp (-(t • (O * blockForm ε * O.transpose))) = O * blockRotation (t • ε) * O.transpose := by
  have hOtO := transpose_mul_self_of_mul_transpose hOO
  have hinv : O⁻¹ = O.transpose := Matrix.inv_eq_left_inv hOtO
  have hunit : IsUnit O :=
    (Matrix.isUnit_iff_isUnit_det O).mpr (Matrix.isUnit_det_of_left_inverse hOtO)
  rw [← exp_neg_smul_blockForm, ← hinv, ← Matrix.exp_conj O _ hunit]
  congr 1
  rw [Matrix.mul_neg, Matrix.neg_mul, Matrix.mul_smul, Matrix.smul_mul]

end Rotated

variable {h : Matrix (MajoranaIndex n) (MajoranaIndex n) ℝ}

/-- Theorem 11(a): `U_h(t)` implements `exp (-t h)`. -/
theorem conjugatesMajorana_evolution (hh : h.transpose = -h) (t : ℝ) :
    ConjugatesMajorana (evolution h t) (exp (-(t • h))) := by
  obtain ⟨O, ε, U, hOO, -, hOε, hU, hU', hUO⟩ := exists_normalForm_unitary h hh
  rw [hOε, evolution_conj hU' hUO hOO, exp_neg_smul_conj hOO]
  have h1 := conjugatesMajorana_mul (conjugatesMajorana_evolution_blockForm ε t) hUO
  have h2 := conjugatesMajorana_mul (conjugatesMajorana_conjTranspose hU' hUO) h1
  simpa only [Matrix.mul_assoc] using h2

lemma exp_neg_smul_apply_swap (hh : h.transpose = -h) (t : ℝ) (a b : MajoranaIndex n) :
    exp (-(t • h)) b a = exp (t • h) a b := by
  rw [← Matrix.transpose_apply (exp (-(t • h))) a b, ← Matrix.exp_transpose, Matrix.transpose_neg,
    Matrix.transpose_smul, hh, smul_neg, neg_neg]

/-- Theorem 11(b): the Heisenberg form `U_h(t)* c_a U_h(t) = ∑_b (exp (t h))_ab c_b`. -/
theorem conjTranspose_mul_majorana_mul_evolution (hh : h.transpose = -h) (t : ℝ)
    (a : MajoranaIndex n) :
    (evolution h t).conjTranspose * majorana a * evolution h t =
      ∑ b, ((exp (t • h) a b : ℝ) : ℂ) • majorana b := by
  rw [conjTranspose_mul_majorana_mul (conjTranspose_mul_evolution hh t)
    (conjugatesMajorana_evolution hh t)]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [exp_neg_smul_apply_swap hh]

/-- Theorem 11(c): a density operator evolves to a density operator with covariance
`exp (t h) Γ(σ) exp (-t h)`. -/
theorem covariance_evolution (hh : h.transpose = -h) (t : ℝ)
    {σ : Matrix (FockIndex n) (FockIndex n) ℂ} (hσ : IsDensity σ) :
    IsDensity (evolution h t * σ * (evolution h t).conjTranspose) ∧
      covariance (evolution h t * σ * (evolution h t).conjTranspose) =
        exp (t • h) * covariance σ * exp (-(t • h)) := by
  have := covariance_conj (evolution_mul_conjTranspose hh t) (conjTranspose_mul_evolution hh t)
    (conjugatesMajorana_evolution hh t) hσ
  refine ⟨this.1, ?_⟩
  rw [this.2, ← Matrix.exp_transpose, Matrix.transpose_neg, Matrix.transpose_smul, hh, smul_neg,
    neg_neg]

/-- `[c_b c_c, c_a] = 2 δ_ca c_b - 2 δ_ba c_c`. -/
lemma pair_commutator (a b c : MajoranaIndex n) :
    majorana b * majorana c * majorana a - majorana a * (majorana b * majorana c) =
      (if c = a then (2 : ℂ) else 0) • majorana b -
        (if b = a then (2 : ℂ) else 0) • majorana c := by
  have h1 : majorana c * majorana a =
      (if c = a then (2 : ℂ) else 0) • (1 : Matrix (FockIndex n) (FockIndex n) ℂ) -
        majorana a * majorana c := eq_sub_of_add_eq (majorana_anticommute c a)
  have h2 : majorana b * majorana a =
      (if b = a then (2 : ℂ) else 0) • (1 : Matrix (FockIndex n) (FockIndex n) ℂ) -
        majorana a * majorana b := eq_sub_of_add_eq (majorana_anticommute b a)
  rw [Matrix.mul_assoc, h1, Matrix.mul_sub, Matrix.mul_smul, Matrix.mul_one, ← Matrix.mul_assoc,
    h2, Matrix.sub_mul, Matrix.smul_mul, Matrix.one_mul, Matrix.mul_assoc]
  abel

/-- Theorem 11(d): the generator identity `i [H_h, c_a] = ∑_b h_ab c_b`. -/
theorem I_smul_commutator_quadHam (hh : h.transpose = -h) (a : MajoranaIndex n) :
    Complex.I • (quadHam h * majorana a - majorana a * quadHam h) =
      ∑ b, ((h a b : ℝ) : ℂ) • majorana b := by
  have key : ∀ b c, hamCoeff h b c •
      (majorana b * majorana c * majorana a - majorana a * (majorana b * majorana c)) =
      (if c = a then 2 * hamCoeff h b c else 0) • majorana b -
        (if b = a then 2 * hamCoeff h b c else 0) • majorana c := by
    intro b c
    rw [pair_commutator, smul_sub, smul_smul, smul_smul]
    congr 2 <;> split_ifs <;> simp [mul_comm]
  have expand : (∑ b, ∑ c, hamCoeff h b c • (majorana b * majorana c)) * majorana a -
      majorana a * ∑ b, ∑ c, hamCoeff h b c • (majorana b * majorana c) =
      ∑ b, ∑ c, hamCoeff h b c •
        (majorana b * majorana c * majorana a - majorana a * (majorana b * majorana c)) := by
    simp only [Matrix.sum_mul, Matrix.mul_sum, Matrix.smul_mul, Matrix.mul_smul,
      ← Finset.sum_sub_distrib, smul_sub]
  have h1 : ∑ b, ∑ c, (if c = a then 2 * hamCoeff h b c else 0) • majorana b =
      ∑ b, (2 * hamCoeff h b a) • majorana b := by
    simp only [ite_smul, zero_smul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  have h2 : ∑ b, ∑ c, (if b = a then 2 * hamCoeff h b c else 0) • majorana c =
      ∑ c, (2 * hamCoeff h a c) • majorana c := by
    rw [Finset.sum_comm]
    simp only [ite_smul, zero_smul, Finset.sum_ite_eq', Finset.mem_univ, ite_true]
  unfold quadHam
  rw [expand]
  simp only [key, Finset.sum_sub_distrib]
  rw [h1, h2, ← Finset.sum_sub_distrib, Finset.smul_sum]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [← sub_smul, smul_smul]
  congr 1
  simp only [hamCoeff, h_apply_swap hh a b]
  push_cast
  ring_nf
  rw [Complex.I_sq]
  ring

/-! ### Corollary 12: stationarity -/

/-- `U_h(t)` commutes with `ρ_h`. -/
theorem evolution_mul_gaussianState_comm (t : ℝ) :
    evolution h t * gaussianState h = gaussianState h * evolution h t := by
  unfold evolution gaussianState
  have hc : Commute ((-(Complex.I * (t : ℂ))) • quadHam h) (-(quadHam h)) :=
    ((Commute.refl (quadHam h)).smul_left _).neg_right
  rw [Matrix.mul_smul, Matrix.smul_mul, ← Matrix.exp_add_of_commute _ _ hc,
    ← Matrix.exp_add_of_commute _ _ hc.symm, add_comm]

/-- Corollary 12: `U_h(t) ρ_h U_h(t)* = ρ_h`. -/
theorem evolution_conj_gaussianState (hh : h.transpose = -h) (t : ℝ) :
    evolution h t * gaussianState h * (evolution h t).conjTranspose = gaussianState h := by
  rw [evolution_mul_gaussianState_comm, Matrix.mul_assoc, evolution_mul_conjTranspose hh,
    Matrix.mul_one]

/-- Corollary 12: `exp (t h) Γ(ρ_h) exp (-t h) = Γ(ρ_h)`. -/
theorem covariance_gaussianState_evolution_invariant (hh : h.transpose = -h) (t : ℝ) :
    exp (t • h) * covariance (gaussianState h) * exp (-(t • h)) = covariance (gaussianState h) := by
  rw [← (covariance_evolution hh t (isDensity_gaussianState h hh)).2,
    evolution_conj_gaussianState hh t]

end Fermionic
